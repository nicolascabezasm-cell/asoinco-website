    <script type="text/javascript">
    if (typeof gform !== 'undefined') {
        gform.addFilter('gform_datepicker_options_pre_init', function(optionsObj, formId, fieldId) {
            // Verificar si el campo tiene la clase "calendario"
            var fieldContainer = document.getElementById('field_' + formId + '_' + fieldId);
            if (fieldContainer && fieldContainer.classList.contains('calendario')) {
                optionsObj.maxDate = 0;
            }
            return optionsObj;
        });
    }
    </script>
        <script type="text/javascript">
    jQuery(document).ready(function($) {
        // Formatear RUT mientras se escribe
        function formatearRut(rut) {
            var valor = rut.replace(/[^0-9kK]/g, '').toUpperCase();
            if (valor.length <= 1) return valor;

            var cuerpo = valor.slice(0, -1);
            var dv = valor.slice(-1);

            var cuerpoFormateado = '';
            var contador = 0;
            for (var i = cuerpo.length - 1; i >= 0; i--) {
                cuerpoFormateado = cuerpo.charAt(i) + cuerpoFormateado;
                contador++;
                if (contador === 3 && i !== 0) {
                    cuerpoFormateado = '.' + cuerpoFormateado;
                    contador = 0;
                }
            }

            return cuerpoFormateado + '-' + dv;
        }

        // Verificar si es RUT de persona natural (no empresa)
        function esRutPersonaNatural(rut) {
            var valor = rut.replace(/[^0-9kK]/g, '').toUpperCase();
            if (valor.length < 2) return true; // Aún no hay suficiente info
            var cuerpo = valor.slice(0, -1);
            var rutNumero = parseInt(cuerpo, 10);
            // RUT >= 50.000.000 son de empresas
            return rutNumero < 50000000;
        }

        // Mostrar/ocultar mensaje de error para RUT de empresa
        function validarRutEmpresa($input) {
            var valor = $input.val();
            var $field = $input.closest('.gfield.rut');
            var errorClass = 'rut-empresa-error';

            // Remover mensaje de error existente
            $field.find('.' + errorClass).remove();

            if (valor.length > 0 && !esRutPersonaNatural(valor)) {
                // Es RUT de empresa, mostrar error
                var $error = $('<div class="' + errorClass + '" style="color: #c02b0a; font-size: 14px; margin-top: 5px;">Solo se permiten RUT de personas naturales.</div>');
                $input.after($error);
                $input.css('border-color', '#c02b0a');
            } else {
                $input.css('border-color', '');
            }
        }

        // Aplicar formateo a campos con clase "rut"
        $(document).on('input blur', '.gfield.rut input[type="text"]', function() {
            var $input = $(this);
            var valor = $input.val();

            if (valor.length > 0) {
                $input.val(formatearRut(valor));
            }

            // Validar si es RUT de empresa
            validarRutEmpresa($input);
        });

        // Re-aplicar después de que Gravity Forms cargue una página
        $(document).on('gform_post_render', function(event, formId) {
            $('#gform_' + formId + ' .gfield.rut input[type="text"]').each(function() {
                var $input = $(this);
                var valor = $input.val();
                if (valor.length > 0) {
                    $input.val(formatearRut(valor));
                    validarRutEmpresa($input);
                }
            });
        });
    });
    </script>
        <script type="text/javascript">
    jQuery(document).ready(function($) {
        // Formatear celular mientras se escribe: 9 XXXX XXXX
        function formatearCelular(celular) {
            var valor = celular.replace(/[^0-9]/g, '');

            // Limitar a 9 dígitos
            if (valor.length > 9) {
                valor = valor.substring(0, 9);
            }

            if (valor.length <= 1) return valor;

            // Formato: 9 XXXX XXXX
            var parte1 = valor.substring(0, 1);
            var parte2 = valor.substring(1, 5);
            var parte3 = valor.substring(5, 9);

            var resultado = parte1;
            if (parte2.length > 0) {
                resultado += ' ' + parte2;
            }
            if (parte3.length > 0) {
                resultado += ' ' + parte3;
            }

            return resultado;
        }

        // Validar celular chileno
        function validarCelularChileno(celular) {
            var valor = celular.replace(/[^0-9]/g, '');

            // Si está vacío o muy corto, no mostrar error todavía
            if (valor.length < 2) return { valido: true, mensaje: '' };

            // Debe comenzar con 9
            if (valor[0] !== '9') {
                return { valido: false, mensaje: 'El celular debe comenzar con 9.' };
            }

            // El segundo dígito no puede ser 0, 1 o 2
            if (valor.length >= 2 && ['0', '1', '2'].indexOf(valor[1]) !== -1) {
                return { valido: false, mensaje: 'Los prefijos 90, 91 y 92 no son válidos para celulares.' };
            }

            // Si tiene 9 dígitos, es válido
            if (valor.length === 9) {
                return { valido: true, mensaje: '' };
            }

            // Si tiene más de 9, es inválido
            if (valor.length > 9) {
                return { valido: false, mensaje: 'El celular debe tener exactamente 9 dígitos.' };
            }

            // Menos de 9 dígitos, aún incompleto pero sin error
            return { valido: true, mensaje: '' };
        }

        // Mostrar/ocultar mensaje de error para celular
        function mostrarErrorCelular($input) {
            var valor = $input.val();
            var $field = $input.closest('.gfield.celular');
            var errorClass = 'celular-error';

            // Remover mensaje de error existente
            $field.find('.' + errorClass).remove();

            var validacion = validarCelularChileno(valor);

            if (!validacion.valido) {
                var $error = $('<div class="' + errorClass + '" style="color: #c02b0a; font-size: 14px; margin-top: 5px;">' + validacion.mensaje + '</div>');
                $input.after($error);
                $input.css('border-color', '#c02b0a');
            } else {
                $input.css('border-color', '');
            }
        }

        // Aplicar formateo a campos con clase "celular"
        $(document).on('input blur', '.gfield.celular input[type="text"], .gfield.celular input[type="tel"]', function() {
            var $input = $(this);
            var valor = $input.val();

            if (valor.length > 0) {
                $input.val(formatearCelular(valor));
            }

            // Validar celular
            mostrarErrorCelular($input);
        });

        // Re-aplicar después de que Gravity Forms cargue una página
        $(document).on('gform_post_render', function(event, formId) {
            $('#gform_' + formId + ' .gfield.celular input[type="text"], #gform_' + formId + ' .gfield.celular input[type="tel"]').each(function() {
                var $input = $(this);
                var valor = $input.val();
                if (valor.length > 0) {
                    $input.val(formatearCelular(valor));
                    mostrarErrorCelular($input);
                }
            });
        });
    });
    </script>
    </body>
